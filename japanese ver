    const listContainer = document.getElementById('list-container');

    Object.keys(dataset).forEach(category => {
        const heading = document.createElement('div');
        heading.className = 'category-title';
        heading.innerText = category;
        listContainer.appendChild(heading);

        dataset[category].forEach(loc => {
            const htmlIcon = L.divIcon({
                html: `<div class="map-custom-marker" style="color: ${loc.color};"><i class="fa-solid ${loc.icon}"></i></div>`,
                className: 'custom-leaflet-div-icon',
                iconSize: [32, 32],
                iconAnchor: [16, 32],
                popupAnchor: [0, -32]
            });

            // Hiển thị Recommended và Highlight dạng HTML
            let popupContent = `
                <div class="popup-card">
                    ${loc.image ? `<img class="popup-img" src="${loc.image}" alt="${loc.name}">` : ''}
                    <div class="popup-title">🏪 ${loc.name}</div>
                    
                    ${loc.recommended_by ? `<div class="popup-meta"><i class="fa-solid fa-thumbs-up"></i> <b style="white-space: nowrap;">紹介者：</b> ${loc.recommended_by}</div>` : ''}
                    ${loc.highlight ? `<div class="popup-meta" style="color:#2b6cb0;"><i class="fa-solid fa-star"></i> <b style="white-space: nowrap;">おすすめポイント：</b> ${loc.highlight}</div>` : ''}
                    
                    <div class="popup-section-title">⏱️ 営業時間・定休日</div>
                    <div class="popup-meta"><i class="fa-regular fa-clock"></i> <b style="white-space: nowrap;">営業時間：</b> ${loc.opening_hours || '[営業時間未定]'}</div>
                    <div class="popup-meta"><i class="fa-solid fa-calendar-xmark"></i> <b style="white-space: nowrap;">定休日：</b> ${loc.dayoff || '[定休日未定]'}</div>
            `;

            // Ẩn bảng thông tin hàng quán phức tạp đối với Suối nước nóng và Điểm xuất phát Ryokufu kaku
            if (category !== "外湯" && category !== "当館") {
                popupContent += `
                    <div class="popup-section-title">💰 予算・決済</div>
                    <div class="popup-meta"><i class="fa-solid fa-money-bill-wave"></i> <b style="white-space: nowrap;">予算：</b> ${loc.price_range || '[予算未定]'}</div>
                    <div class="popup-meta"><i class="fa-regular fa-credit-card"></i> <b style="white-space: nowrap;">カード決済：</b> ${loc.credit_card || '[利用可 / 不可 / 現金のみ]'}</div>
                    
                    <div class="popup-section-title">👥 席・サービス</div>
                    <div class="popup-meta"><i class="fa-solid fa-chair"></i> <b style="white-space: nowrap;">利用形態：</b> ${loc.dine_in || '[店内飲食 / テイクアウト]'}</div>
                    
                    <div class="popup-section-title">⏳ 混雑・予約</div>
                    <div class="popup-meta"><i class="fa-solid fa-hourglass-half"></i> <b style="white-space: nowrap;">混雑時間帯：</b> ${loc.peak_hours || '[時間帯未定]'}</div>
                    <div class="popup-meta"><i class="fa-solid fa-stopwatch"></i> <b style="white-space: nowrap;">待ち時間目安：</b> ${loc.avg_waiting_time || '[待ち時間未定]'}</div>
                    <div class="popup-meta"><i class="fa-regular fa-calendar-check"></i> <b style="white-space: nowrap;">予約：</b> ${loc.reservation || '[予約不要 / 予約推奨 / 要予約]'}</div>
                `;
            }

            if (loc.google_maps_link) {
                popupContent += `
                    <a href="${loc.google_maps_link}" target="_blank" class="gmaps-btn">
                        <i class="fa-solid fa-map-location-dot"></i> Google Mapsで見る
                    </a>
                `;
            }

            popupContent += `</div>`;

            const marker = L.marker([loc.lat, loc.lng], { icon: htmlIcon }).addTo(map);
            marker.bindPopup(popupContent);

            const item = document.createElement('div');
            item.className = 'location-item';
            item.innerHTML = `
                <div class="location-item-icon" style="background-color: ${loc.color}20; color: ${loc.color};">
                    <i class="fa-solid ${loc.icon}"></i>
                </div>
                <div class="location-item-info">
                    <div class="location-item-name">${loc.name}</div>
                    <div class="location-item-desc">${loc.opening_hours ? `営業時間: ${loc.opening_hours}` : 'クリックして詳細を表示'}</div>
                </div>
            `;

            item.addEventListener('click', () => {
                map.setView([loc.lat, loc.lng], 18, { animate: true, duration: 1 });
                marker.openPopup();
                if (window.innerWidth <= 768) {
                    document.getElementById('map').scrollIntoView({ behavior: 'smooth' });
                }
            });

            listContainer.appendChild(item);
        });
    });

